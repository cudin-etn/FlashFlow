{
  "$schema": "https://wails.io/schemas/config.v2.json",
  "name": "FlashFlow",
  "outputfilename": "FlashFlow",
  "frontend:install": "npm install",
  "frontend:build": "npm run build",
  "frontend:dev:watcher": "npm run dev",
  "frontend:dev:serverUrl": "auto",
  "author": {
    "name": "cudin-etn",
    "email": "tungninh88@gmail.com"
  },
  "description": "Modern Android ROM flashing tool",
  "version": "2.1.4",
  "info": {
    "productName": "FlashFlow",
    "productVersion": "2.1.4",
    "copyright": "© 2026 TungNinh",
    "comments": "Android Flashing Utility"
  },
  "windows": {
    "icon": "build/icon.ico",
    "width": 1200,
    "height": 860,
    "minWidth": 1200,
    "minHeight": 860,
    "resizable": true,
    "webview2": {
      "install": true
    }
  },
  "mac": {
    "icon": "build/icon.icns",
    "width": 1200,
    "height": 860,
    "minWidth": 1200,
    "minHeight": 860
  },

  "updater": {
    "provider": "github",
    "repo": "github.com/cudin-etn/FlashFlow/",
    "channel": "stable"
  }
}
